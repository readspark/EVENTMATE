rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             data.creatorEmail is string && data.creatorEmail.size() <= 200;
    }

    // Events collection
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isValidId(eventId) && isValidEvent(request.resource.data);
      allow update: if isValidId(eventId) && isValidEvent(request.resource.data);
      allow delete: if isValidId(eventId);
    }
  }
}
